# Environment Configuration
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spendguard?schema=public"

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Authentication
JWT_ACCESS_SECRET="spendguard-jwt-access-secret-32b-min!"
JWT_REFRESH_SECRET="spendguard-jwt-refresh-secret-32b-min!"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Master Encryption Key for Provider API Key Vault (AES-256-GCM, 32 bytes)
ENCRYPTION_MASTER_KEY="spendguard-master-encryption-key-32b!"

# External Provider Master Keys (Optional fallbacks)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Gateway Defaults
GATEWAY_FAIL_CLOSED_ON_ERROR=true
GATEWAY_PROXY_TIMEOUT_MS=60000
