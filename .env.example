# Root environment for `docker compose up`. Copy to `.env` (git-ignored) and fill in.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# The backend refuses to start in production if these are missing, shorter than
# 32 characters, identical, or equal to a value published in this repository.

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Encrypts every stored provider API key. Back it up: losing it makes the vault unreadable.
ENCRYPTION_MASTER_KEY=

# Database password used by the postgres container and the backend
POSTGRES_PASSWORD=

# Public URL of the web app (used for Stripe redirect URLs)
APP_URL=http://localhost:3000
# Origins allowed to call the API directly from a browser (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Set to the number of trusted reverse-proxy hops (e.g. 1) when deployed behind a load balancer,
# so per-IP rate limiting sees the real client address. Leave empty otherwise.
TRUST_PROXY=

# Comma-separated emails allowed to edit the shared model pricing catalog
PLATFORM_ADMIN_EMAILS=

# Optional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform provider keys are never used for tenant traffic in production (the
# compose backend runs with NODE_ENV=production, so ALLOW_PLATFORM_PROVIDER_KEY has
# no effect). Each project stores its own key in the Key Vault; a project without
# one gets 400 missing_provider_key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
