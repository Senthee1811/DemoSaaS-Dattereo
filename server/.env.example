# Local development configuration for running the backend outside Docker.
# Copy to server/.env. For production use the root .env.example with docker compose.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL - matches docker-compose default)
DATABASE_URL="postgresql://spendguard:spendguard_secure_password@localhost:5432/spendguard?schema=public"

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Authentication — DEVELOPMENT VALUES ONLY.
# These are published in this repo; the server refuses to boot with them when NODE_ENV=production.
# Generate real ones: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="spendguard-jwt-access-secret-32b-min!"
JWT_REFRESH_SECRET="spendguard-jwt-refresh-secret-32b-min!"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Master Encryption Key for Provider API Key Vault (AES-256-GCM) — development value only
ENCRYPTION_MASTER_KEY="spendguard-master-encryption-key-32b!"

# Web app URL (Stripe redirects) and browser origins allowed to call the API directly
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# Number of trusted proxy hops in front of the API (leave empty when not behind a proxy)
TRUST_PROXY=""

# Auth brute-force limits (per minute). Per-IP applies to login, register,
# forgot-password and reset-password; per-email to login, register, forgot-password.
# Fails open if Redis is down. Behind the Next.js BFF every browser request arrives
# from the BFF's address, so set TRUST_PROXY (and keep the API port private) or the
# per-IP limit is shared by all users.
AUTH_IP_RPM=10
AUTH_EMAIL_RPM=5

# Emails allowed to edit the shared model pricing catalog (comma-separated)
PLATFORM_ADMIN_EMAILS=""

# Platform provider keys. Tenant traffic NEVER uses these unless BOTH
#   ALLOW_PLATFORM_PROVIDER_KEY=true  AND  NODE_ENV is not "production".
# The opt-in exists only so a developer can try the gateway locally without
# adding a key to the vault. Otherwise a project with no stored provider key
# gets 400 missing_provider_key and its budget hold is released.
ALLOW_PLATFORM_PROVIDER_KEY=false
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
# Optional OpenAI-compatible endpoint (Azure/OpenAI proxies, local mocks)
OPENAI_BASE_URL=""

# Gateway Defaults
GATEWAY_FAIL_CLOSED_ON_ERROR=true
GATEWAY_PROXY_TIMEOUT_MS=60000
# Per-IP gateway limits are abuse protection only; real limits are per key (RPM/TPM).
# Server apps send everything from one IP, so keep this well above any key's RPM.
GATEWAY_IP_RPM=6000
# Requests that carry no credentials at all (scanners, broken clients)
GATEWAY_UNAUTH_IP_RPM=60
# Budget hold lifetime (ms). Default: max(5 min, proxy timeout + 60 s)
# BUDGET_HOLD_TTL_MS=300000

# Budget ledger reconciliation interval (ms)
BUDGET_RECONCILE_INTERVAL_MS=300000

# Stripe (Optional - leave empty for stub mode)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Model catalog availability check (daily BullMQ job + `npm run sync:model-catalog`).
# Read-only keys used ONLY to list model IDs; providers without a key are skipped.
# Providers publish no price API, so prices stay a maintained table; this only flags
# models a provider no longer lists. Never the tenant/gateway keys.
MODEL_CATALOG_OPENAI_API_KEY=""
MODEL_CATALOG_ANTHROPIC_API_KEY=""
MODEL_CATALOG_GEMINI_API_KEY=""
# MODEL_CATALOG_SYNC_INTERVAL_MS=86400000
