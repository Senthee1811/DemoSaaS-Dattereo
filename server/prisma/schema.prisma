// SpendGuard AI Spend Governance Platform - Prisma Schema (PRD Section 7)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ProviderType {
  OPENAI
  ANTHROPIC
  GEMINI
  GROQ
}

enum ThresholdType {
  PERCENT_80
  HARD_BLOCK
  ANOMALY_DETECTED
}

enum AlertChannel {
  EMAIL
  SLACK
  IN_APP
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  users         User[]
  projects      Project[]
  subscription  Subscription?
  recommendations       Recommendation[]
  notificationChannels  NotificationChannel[]
  notificationDeliveries NotificationDelivery[]

  @@map("organizations")
}

// Isolated billing domain — no relation into cost-engine tables beyond Organization
model Subscription {
  id                    String    @id @default(uuid())
  orgId                 String    @unique @map("org_id")
  stripeCustomerId      String    @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?   @unique @map("stripe_subscription_id")
  tier                  String    // "starter" | "growth" | "enterprise"
  status                String    // Stripe subscription status
  currentPeriodEnd      DateTime? @map("current_period_end")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model User {
  id           String       @id @default(uuid())
  orgId        String       @map("org_id")
  email        String       @unique
  passwordHash String       @map("password_hash")
  name         String
  role         Role         @default(MEMBER)
  avatarUrl    String?      @map("avatar_url")
  deactivatedAt DateTime?   @map("deactivated_at")
  /** When the password was last changed (null = never changed since the account was created). */
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requests     Request[]
  sessions     UserSession[]

  @@index([orgId])
  @@map("users")
}

/// A signed-in browser/device. The refresh token carries its id (`sid`); revoking the row makes every
/// token of that session stop refreshing. Created at sign-in/registration, never edited otherwise.
model UserSession {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model Project {
  id                     String            @id @default(uuid())
  orgId                  String            @map("org_id")
  name                   String
  slug                   String
  description            String?
  budgetMonthly          Decimal           @default(1000.0) @map("budget_monthly") @db.Decimal(12, 4)
  budgetWeekly           Decimal           @default(250.0) @map("budget_weekly") @db.Decimal(12, 4)
  budgetHardBlockEnabled Boolean           @default(true) @map("budget_hard_block_enabled")
  /// Store prompt/response previews in the request ledger. Off by default (privacy).
  logRequestContent      Boolean           @default(false) @map("log_request_content")
  isBlocked              Boolean           @default(false) @map("is_blocked")
  blockReason            String?           @map("block_reason")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  organization           Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  providerKeys           ProviderApiKey[]
  gatewayKeys            GatewayApiKey[]
  requests               Request[]
  budgetAlerts           BudgetAlert[]
  alertConfig            AlertConfig?
  requestAttempts        RequestAttempt[]
  recommendations        Recommendation[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("projects")
}

model AlertConfig {
  id                  String   @id @default(uuid())
  projectId           String   @unique @map("project_id")
  slackWebhookUrl     String?  @map("slack_webhook_url") // encrypted (EncryptionService); never returned by the API
  emailRecipients     String?  @map("email_recipients") // JSON array string
  warningThresholdPct Decimal  @default(80.0) @map("warning_threshold_pct") @db.Decimal(5, 2)
  hardBlockPct        Decimal  @default(100.0) @map("hard_block_pct") @db.Decimal(5, 2)
  notifyOnAnomaly     Boolean  @default(true) @map("notify_on_anomaly")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("alert_configs")
}

model ProviderApiKey {
  id            String       @id @default(uuid())
  projectId     String       @map("project_id")
  provider      ProviderType
  keyName       String       @map("key_name")
  keyPrefix     String       @map("key_prefix")
  encryptedKey  String       @map("encrypted_key")
  maskedPreview String?      @map("masked_preview")
  isActive      Boolean      @default(true) @map("is_active")
  lastUsedAt    DateTime?    @map("last_used_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, provider])
  @@map("provider_api_keys")
}

model GatewayApiKey {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  keyName          String    @map("key_name")
  keyPrefix        String    @map("key_prefix")
  hashedSecret     String    @unique @map("hashed_secret")
  environment      String    @default("live") @map("environment") // "live" | "test"
  allowedProviders String?   @map("allowed_providers") // JSON array string e.g. ["OPENAI","GEMINI"]
  allowedModels    String?   @map("allowed_models")    // JSON array string
  budgetMonthly    Decimal?  @map("budget_monthly") @db.Decimal(12, 4)
  expiresAt        DateTime? @map("expires_at")
  rateLimitRpm     Int       @default(1200) @map("rate_limit_rpm")
  rateLimitTpm     Int?      @default(100000) @map("rate_limit_tpm")
  /// Attribution assigned by the key's creator (an org admin). When set it is AUTHORITATIVE for requests made
  /// with this key: a client header can never re-attribute spend to another application/team.
  application      String?   @db.VarChar(64)
  team             String?   @db.VarChar(64)
  isActive         Boolean   @default(true) @map("is_active")
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requests         Request[]

  @@index([projectId])
  @@index([hashedSecret])
  @@map("gateway_api_keys")
}

model Request {
  id              String       @id
  projectId       String       @map("project_id")
  userId          String?      @map("user_id")
  /// Gateway key that made the request (null for dashboard-session requests). Per-key spend reconciles from this.
  gatewayKeyId    String?      @map("gateway_key_id")
  provider        ProviderType
  model           String
  tokensIn        Int          @map("tokens_in")
  tokensOut       Int          @map("tokens_out")
  totalTokens     Int          @map("total_tokens")
  costEstimate    Decimal      @map("cost_estimate") @db.Decimal(10, 6)
  latencyMs       Int          @map("latency_ms")
  statusCode      Int          @default(200) @map("status_code")
  isAnomaly       Boolean      @default(false) @map("is_anomaly")
  anomalyReason   String?      @map("anomaly_reason")
  isBlocked       Boolean      @default(false) @map("is_blocked")
  promptPreview   String?      @map("prompt_preview")
  responsePreview String?      @map("response_preview")
  metadataJson    String?      @map("metadata_json")
  /// Worst-case amount held for this request (USD). Compare with costEstimate to see reservation accuracy.
  reservedCostUsd Decimal?     @map("reserved_cost_usd") @db.Decimal(10, 6)
  /// max(0, costEstimate - reservedCostUsd): spend that the reservation did NOT cover.
  reservationOverrunUsd Decimal @default(0) @map("reservation_overrun_usd") @db.Decimal(10, 6)
  /// Spike evaluation is asynchronous. PENDING (not evaluated yet) | CLEAR | ANOMALY (confirmed)
  /// | FAILED (evaluation could not complete) | SKIPPED (blocked request, never evaluated).
  /// isAnomaly is true only for ANOMALY.
  anomalyStatus   String       @default("PENDING") @map("anomaly_status")
  anomalyEvaluatedAt DateTime? @map("anomaly_evaluated_at")
  /// Attribution. NULL means "not attributed" and is reported as such, never guessed. Source: the gateway key's
  /// assigned value, else a validated client header (X-SpendGuard-Application / -Team / -Tags).
  application     String?      @db.VarChar(64)
  team            String?      @db.VarChar(64)
  /// Extra client-supplied tags (max 5, validated key/value shapes). Extensible without schema changes.
  tags            Json?
  /// Input tokens served from the provider's prompt cache (a subset of tokensIn). NULL = not recorded (rows from
  /// before this column existed); the model comparison treats NULL as 0 and says how many rows lacked it.
  cachedTokensIn  Int?         @map("cached_tokens_in")
  createdAt       DateTime     @default(now()) @map("created_at")

  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  gatewayKey      GatewayApiKey? @relation(fields: [gatewayKeyId], references: [id], onDelete: SetNull)
  auditLogs       AuditLog[]

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([gatewayKeyId, createdAt])
  @@index([model])
  @@index([createdAt])
  @@index([anomalyStatus, createdAt])
  @@index([projectId, application, createdAt])
  @@index([projectId, team, createdAt])
  @@map("requests")
}

/// An evidence-based finding about spend. Generated deterministically from the ledger (no model is involved);
/// `evidence` holds the numbers and ledger request ids it was computed from, `method` how.
/// Statuses: OPEN -> ACKNOWLEDGED | APPROVED_FOR_EVALUATION | DISMISSED; RESOLVED when the condition no longer holds.
/// APPROVED_FOR_EVALUATION records a human decision only: SpendGuard never changes a customer's model configuration.
model Recommendation {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  projectId        String?   @map("project_id")
  type             String
  /// Stable identity of the finding (type + scope + period bucket): regeneration updates it instead of duplicating it.
  fingerprint      String
  status           String    @default("OPEN")
  severity         String
  title            String
  summary          String
  evidence         Json
  method           String
  impactLowUsd     Decimal?  @map("impact_low_usd") @db.Decimal(14, 4)
  impactHighUsd    Decimal?  @map("impact_high_usd") @db.Decimal(14, 4)
  /// What the impact figures cover, e.g. "per month" or "over the last 7 days".
  impactBasis      String?   @map("impact_basis")
  confidence       String
  action           String
  requiresApproval Boolean   @default(false) @map("requires_approval")
  firstSeenAt      DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  decidedById      String?   @map("decided_by_id")
  decidedAt        DateTime? @map("decided_at")
  decisionNote     String?   @map("decision_note") @db.VarChar(500)
  dismissedUntil   DateTime? @map("dismissed_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([orgId, fingerprint])
  @@index([orgId, status])
  @@index([projectId])
  @@map("recommendations")
}

/// An organization-level destination for notifications. The destination details (URL, secret, recipients) are
/// encrypted at rest and never returned by the API; `configHint` is a non-sensitive description (host / masked address).
model NotificationChannel {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  /// SLACK | WEBHOOK | EMAIL (in-app delivery is built in and needs no channel)
  type            String
  name            String   @db.VarChar(100)
  encryptedConfig String   @map("encrypted_config")
  configHint      String?  @map("config_hint")
  /// Empty = every event type.
  eventTypes      String[] @default([]) @map("event_types")
  enabled         Boolean  @default(true)
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization    Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries      NotificationDelivery[]

  @@index([orgId, enabled])
  @@map("notification_channels")
}

/// One attempt-history record per (event, destination). Written BEFORE delivery is attempted, so every outcome
/// (SENT / FAILED) is visible and a lost queue job can be recovered from here.
model NotificationDelivery {
  id            String    @id @default(uuid())
  orgId         String    @map("org_id")
  /// NULL for the built-in in-app inbox.
  channelId     String?   @map("channel_id")
  channelType   String    @map("channel_type")
  eventId       String    @map("event_id")
  eventType     String    @map("event_type")
  /// QUEUED | RETRYING | SENT | FAILED
  status        String    @default("QUEUED")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.VarChar(300)
  lastAttemptAt DateTime? @map("last_attempt_at")
  deliveredAt   DateTime? @map("delivered_at")
  /// The event as sent (title, message, ids, numbers). Never contains credentials or request content.
  payload       Json
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  organization  Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel       NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@unique([channelId, eventId])
  @@index([orgId, createdAt])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

/// A gateway call that FAILED before producing a billable result (provider error, timeout, bad key).
/// Separate from `requests` on purpose: `requests` is the spend ledger and sums to the bill; this table
/// never carries spend. estimatedCostUsd is the worst-case reservation that was RELEASED, not money spent.
/// No prompts, no provider credentials, no headers and no raw provider bodies are stored here.
model RequestAttempt {
  id               String       @id // same id space as requests.id (req_<uuid>)
  orgId            String       @map("org_id")
  projectId        String       @map("project_id")
  gatewayKeyId     String?      @map("gateway_key_id")
  userId           String?      @map("user_id")
  provider         ProviderType
  model            String
  /// SpendGuard classification, e.g. upstream_auth_failed, upstream_rate_limited, upstream_timeout,
  /// upstream_network_error, upstream_server_error, upstream_invalid_request, missing_provider_key.
  errorClass       String       @map("error_class")
  /// Status returned to the caller.
  httpStatus       Int          @map("http_status")
  /// Status the provider returned, when there was one.
  upstreamStatus   Int?         @map("upstream_status")
  /// Provider's own short error code (scrubbed, truncated), e.g. rate_limit_exceeded.
  upstreamCode     String?      @map("upstream_code")
  estimatedCostUsd Decimal      @map("estimated_cost_usd") @db.Decimal(10, 6)
  durationMs       Int          @map("duration_ms")
  createdAt        DateTime     @default(now()) @map("created_at")

  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([projectId, createdAt])
  @@index([gatewayKeyId, createdAt])
  @@index([errorClass])
  @@map("request_attempts")
}

model BudgetAlert {
  id             String        @id @default(uuid())
  projectId      String        @map("project_id")
  thresholdType  ThresholdType @map("threshold_type")
  thresholdValue Decimal       @map("threshold_value") @db.Decimal(12, 4)
  channel        AlertChannel  @default(IN_APP)
  title          String
  message        String
  isRead         Boolean       @default(false) @map("is_read")
  // IN_APP (feed only) | QUEUED (Slack delivery pending) | SENT | FAILED.
  // SENT/FAILED are only ever written by the alert-delivery worker after a real HTTP response.
  status         String        @default("IN_APP")
  triggeredAt    DateTime      @default(now()) @map("triggered_at")
  deliveredAt    DateTime?     @map("delivered_at")
  deliveryError  String?       @map("delivery_error")

  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isRead])
  @@index([triggeredAt])
  @@map("budget_alerts")
}

model AuditLog {
  id        String   @id @default(uuid())
  requestId String?  @map("request_id")
  actor     String
  action    String
  metadata  String?  @map("metadata") // JSON details
  createdAt DateTime @default(now()) @map("created_at")

  request   Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([createdAt])
  @@index([actor, createdAt])
  @@map("audit_log")
}

// Versioned, externally-configurable model pricing table per PRD FR4 & Step 6
model ModelPricing {
  id                    String       @id @default(uuid())
  provider              ProviderType
  model                 String       @unique
  displayName           String?      @map("display_name")
  inputPricePerMillion  Decimal      @map("input_price_per_million") @db.Decimal(10, 4)
  outputPricePerMillion Decimal      @map("output_price_per_million") @db.Decimal(10, 4)
  cachedInputPrice      Decimal?     @map("cached_input_price") @db.Decimal(10, 4)
  contextWindow         Int?         @map("context_window")
  effectiveFrom         DateTime     @default(now()) @map("effective_from")
  effectiveTo           DateTime?    @map("effective_to")
  isActive              Boolean      @default(true) @map("is_active")
  // Where the PRICE came from: 'manual' (maintained table) or 'provider_api'.
  // No provider exposes live per-token prices today, so this is 'manual' for every row.
  source                String       @default("manual")
  // When the price itself last changed (not when a sync merely re-checked the row)
  priceUpdatedAt        DateTime     @default(now()) @map("price_updated_at")
  // Result of the last availability check against the provider's models-list endpoint:
  // 'available' | 'missing' (provider no longer lists it) | null (never checked)
  providerStatus        String?      @map("provider_status")
  providerCheckedAt     DateTime?    @map("provider_checked_at")
  // Provider-announced shutdown date, when the models-list endpoint reports one
  retiresAt             DateTime?    @map("retires_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  @@index([provider, isActive])
  @@map("model_pricing")
}


// Stripe retries any webhook that did not get a 2xx, so each event ID is recorded in the
// same transaction as its effects. A redelivered event hits the primary key and is skipped.
model ProcessedWebhookEvent {
  id          String   @id // Stripe event ID (evt_...)
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_webhook_events")
}
